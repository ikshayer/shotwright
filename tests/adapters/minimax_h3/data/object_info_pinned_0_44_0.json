 "CreateVideo": {
  "api_node": false,
  "category": "video",
  "deprecated": false,
  "description": "Create a video from images.",
  "dev_only": false,
  "display_name": "Create Video",
  "essentials_category": "Video Tools",
  "experimental": false,
  "has_intermediate_output": false,
  "input": {
   "optional": {
    "audio": [
     "AUDIO",
     {
      "tooltip": "The audio to add to the video."
     }
    ],
    "bit_depth": [
     "COMBO",
     {
      "default": "auto",
      "multiselect": false,
      "options": [
       "auto",
       8,
       10
      ],
      "tooltip": "Auto uses 8-bit for sRGB and 10-bit for HDR. Explicit 8-bit and 10-bit choices are independent of colorspace."
     }
    ],
    "chroma_subsampling": [
     "COMBO",
     {
      "default": "auto",
      "multiselect": false,
      "options": [
       "auto",
       "444",
       "422",
       "420"
      ],
      "tooltip": "444 keeps full color resolution, 422 halves horizontal color resolution, and 420 halves both axes. Auto uses the codec default. Unsupported choices use the closest supported mode and print a console warning."
     }
    ],
    "codec": [
     "COMBO",
     {
      "advanced": true,
      "default": "none",
      "multiselect": false,
      "options": [
       "none",
       "auto",
       "h264",
       "av1",
       "prores"
      ],
      "tooltip": "Optionally encode the video immediately. None keeps the images in tensor form; Auto uses H.264."
     }
    ],
    "color_space": [
     "COMBO",
     {
      "default": "sRGB",
      "multiselect": false,
      "options": [
       "sRGB",
       "HDR",
       "HDR PQ"
      ],
      "tooltip": "Colorspace of the input images. HDR selects BT.2020/HLG and HDR PQ selects BT.2020/PQ."
     }
    ]
   },
   "required": {
    "fps": [
     "FLOAT",
     {
      "default": 30.0,
      "max": 120.0,
      "min": 1.0,
      "step": 1.0
     }
    ],
    "images": [
     "IMAGE",
     {
      "tooltip": "The images to create a video from."
     }
    ]
   }
  },
  "input_order": {
   "optional": [
    "audio",
    "bit_depth",
    "color_space",
    "chroma_subsampling",
    "codec"
   ],
   "required": [
    "images",
    "fps"
   ]
  },
